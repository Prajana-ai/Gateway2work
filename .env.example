# Database
DATABASE_URL=postgresql://impactforge:localdev@localhost:5432/impactforge_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=impactforge
DATABASE_PASSWORD=localdev
DATABASE_NAME=impactforge_dev

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace-with-secure-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=24h
MFA_ISSUER=ImpactForge

# Azure (production only)
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net
# AZURE_STORAGE_CONNECTION_STRING=

# App
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
