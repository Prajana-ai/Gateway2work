{
  "name": "@impactforge/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src/",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "node-pg-migrate up --migrations-dir src/database/migrations --database-url-var DATABASE_URL",
    "db:migrate:down": "node-pg-migrate down --migrations-dir src/database/migrations --database-url-var DATABASE_URL",
    "db:seed": "ts-node src/database/seeds/run-seeds.ts",
    "db:mock": "ts-node src/database/seeds/mock-data.ts",
    "db:mock:built": "node dist/database/seeds/mock-data.js"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@impactforge/shared": "*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "helmet": "^8.0.0",
    "otplib": "^12.0.1",
    "papaparse": "^5.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "node-pg-migrate": "^7.9.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  }
}
